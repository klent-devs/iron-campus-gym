# ── Local API (apps/api) ────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Local PostgreSQL on the front-desk PC. Create the database first:
#   createdb -U postgres iron_campus_gym
# Or run it in Docker instead: set POSTGRES_PASSWORD below, then `docker compose up -d`
# (the database is created automatically). Use the same password in DATABASE_URL.
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
DATABASE_URL=postgres://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/iron_campus_gym
# Allowed origin for the admin website (Vite dev server)
ADMIN_ORIGIN=http://localhost:5173

# ── Supabase (cloud) — filled in at milestone 8 ─────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Never put this in the admin or member-portal apps.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Gym defaults ────────────────────────────────────────────────────
GYM_TIMEZONE=Asia/Manila
