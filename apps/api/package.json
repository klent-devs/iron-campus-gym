{
  "name": "@icg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IRON CAMPUS GYM local backend (Node.js + Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "knex seed:run",
    "db:make": "knex migrate:make"
  },
  "dependencies": {
    "@icg/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
